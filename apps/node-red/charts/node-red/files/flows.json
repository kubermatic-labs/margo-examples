    {
        "id": "6d617267f0000007",
        "type": "function",
        "z": "6d617267f0000001",
        "name": "greeting",
        "func": "msg.payload = \"Hello from Node-RED on \" + env.get(\"NODE_NAME\") + \"\\n\";\nmsg.headers = { \"content-type\": \"text/plain; charset=utf-8\" };\nreturn msg;",
